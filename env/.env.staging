# Environment
ENV=staging
AUTH_PROVIDER=session

# Server
SERVER_PORT=8081
SERVER_NAME=kickstart-springboot

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=kickstart_db

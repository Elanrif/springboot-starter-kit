ENV=local
AUTH_PROVIDER=keycloak

SERVER_PORT=8081
SERVER_NAME=kickstart-springboot

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=kickstart_db
POSTGRES_URL=jdbc:postgresql://localhost:5432/kickstart_db

# Reset Token
RESET_TOKEN_HMAC=HmacSHA256
RESET_TOKEN_SECRET_KEY=TON_SECRET

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=kickstart-realm
KEYCLOAK_CLIENT_ID=kickstart-client

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin